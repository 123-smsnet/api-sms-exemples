<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="send_sms_wizard_view_form" model="ir.ui.view">
        <field name="name">sms123.send.wizard.form</field>
        <field name="model">sms123.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Envoyer un SMS via 123-SMS">
                <group>
                    <field name="numero"/>
                    <field name="message" placeholder="160 caractères GSM par SMS (message long : facturation par segment)."/>
                </group>
                <footer>
                    <button name="action_envoyer" string="Envoyer le SMS" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_send_sms_wizard" model="ir.actions.act_window">
        <field name="name">Envoyer un SMS (123-SMS)</field>
        <field name="res_model">sms123.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
