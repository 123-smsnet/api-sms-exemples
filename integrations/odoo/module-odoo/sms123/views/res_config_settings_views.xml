<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sms123" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sms123</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="123-SMS" name="sms123">
                    <block title="Compte 123-SMS.net" help="Inscription gratuite (5 SMS offerts) sur www.123-sms.net — identifiant et clé API transmis par e-mail à l'inscription.">
                        <setting string="Identifiant" help="Identifiant du compte (espace client &gt; API)">
                            <field name="sms123_identifiant"/>
                        </setting>
                        <setting string="Clé API">
                            <field name="sms123_cleapi" password="True"/>
                        </setting>
                        <setting string="Sender-ID (optionnel)" help="Nom d'expéditeur personnalisé, à déclarer auprès de 123-SMS">
                            <field name="sms123_sender"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
